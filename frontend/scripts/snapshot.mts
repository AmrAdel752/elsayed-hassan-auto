/**
 * Pre-build: downloads everything the dashboard manages (categories, products, offers, reviews, gallery)
 * from the live API and writes it into src/app/data/snapshot.ts, which is bundled into the site.
 * So the pages show the real data the moment they open, with no waiting for the server; the app still
 * asks the API in the background and swaps in anything newer.
 *
 * Runs automatically before `npm run build` (Node 24 runs this TypeScript file directly). Every dashboard
 * change triggers a new Cloudflare Pages build (deploy hook called by the API), so the snapshot stays current.
 * If the API can't be reached, the existing snapshot.ts is kept and the build goes on.
 * API address: the SITE_API env var, else the production API.
 */
import { existsSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const API = (process.env['SITE_API'] || 'https://api.elsayedhassanauto.com').replace(/\/$/, '');
const out = join(dirname(fileURLToPath(import.meta.url)), '../src/app/data/snapshot.ts');

/** GET with a generous timeout and retries: the server may be waking up. */
async function get(path: string): Promise<unknown> {
  let last: unknown;
  for (let attempt = 1; attempt <= 4; attempt++) {
    try {
      const r = await fetch(`${API}/api/${path}`, { signal: AbortSignal.timeout(30000), headers: { accept: 'application/json' } });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      return await r.json();
    } catch (e) {
      last = e;
      await new Promise(res => setTimeout(res, attempt * 2000));
    }
  }
  throw new Error(`${path}: ${last}`);
}

/** The API sends null for empty optional fields; the pages expect them to be absent. */
const strip = (v: unknown): unknown =>
  Array.isArray(v) ? v.map(strip)
  : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).filter(([, x]) => x !== null).map(([k, x]) => [k, strip(x)]))
  : v;

try {
  const [categories, products, offers, reviews, gallery] = await Promise.all(
    ['categories', 'products', 'offers', 'reviews', 'gallery'].map(get));
  const data = strip({ at: new Date().toISOString(), categories, products, offers, reviews, gallery });
  writeFileSync(out, `// Generated by scripts/snapshot.mts at build time from ${API} — do not edit by hand.
import type { Category, Offer, Product } from './catalog';
import type { Review } from './reviews';
import type { BeforeAfter, GalleryItem } from './gallery';

export interface Snapshot {
  at: string; categories: Category[]; products: Product[]; offers: Offer[]; reviews: Review[];
  gallery: { items: GalleryItem[]; beforeAfter: BeforeAfter[] };
}

export const SNAPSHOT: Snapshot = ${JSON.stringify(data, null, 1)};
`);
  const d = data as { products: unknown[]; offers: unknown[]; reviews: unknown[] };
  console.log(`snapshot: ${d.products.length} products, ${d.offers.length} offers, ${d.reviews.length} reviews from ${API}`);
} catch (e) {
  if (!existsSync(out)) throw e;
  console.warn(`snapshot: API not reachable (${e}) — keeping the existing src/app/data/snapshot.ts`);
}
